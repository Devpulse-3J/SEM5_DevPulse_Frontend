# Copy to .env.local and fill in real values. NEVER commit .env.local.
NEXTAUTH_SECRET=replace-me-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
# GitHub OAuth App Client ID
NEXT_PUBLIC_GITHUB_CLIENT_ID=your_github_oauth_client_id
# GitHub OAuth Callback URL (must match GitHub OAuth App configuration)
NEXT_PUBLIC_GITHUB_REDIRECT_URI=https://odineye.cse23.org/auth/github/callback
